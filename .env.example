# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Get this from MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/blinktalk

# JWT Secret Key (use a random, strong secret in production)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Token Expiration Time
JWT_EXPIRE=7d

# Cloudinary Configuration (for image/file uploads)
# Sign up at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS) - the Vite dev server
FRONTEND_URL=http://localhost:5173

# Stranger chat (defaults shown)
ANON_DAILY_LIMIT=15
STRANGER_TAG_WAIT_MS=5000
STRANGER_FILTER_WAIT_MS=15000
STRANGER_SEARCH_COOLDOWN_MS=1500
REPORT_BAN_THRESHOLD=3

# Login/signup attempts per IP every 10 minutes
AUTH_RATE_LIMIT=20

# Set to 1 when running behind a proxy (Render, Railway, Nginx)
# TRUST_PROXY=1

# Admin Email (optional)
ADMIN_EMAIL=admin@blinktalk.com
