{
  "name": "blinktalk",
  "version": "1.0.0",
  "description": "Real-time chat application with anonymous stranger chat feature",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:server\" \"npm:client\"",
    "build": "npm install --prefix client && npm run build --prefix client",
    "test": "node --test \"tests/**/*.test.js\" && npm test --prefix client"
  },
  "keywords": [
    "chat",
    "real-time",
    "socket.io",
    "anonymous",
    "nodejs"
  ],
  "author": "devKiNGCRiC",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devKiNGCRiC/blinktalk.git"
  },
  "homepage": "https://github.com/devKiNGCRiC/blinktalk#readme",
  "engines": {
    "node": ">=20.19"
  },
  "nodemonConfig": {
    "watch": [
      "backend"
    ]
  }
}
